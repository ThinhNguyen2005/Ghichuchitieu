<?xml version="1.0" encoding="utf-8"?>
<!--
  Icon "ví" thuần hình học, không gradient, không hiệu ứng 3D.
  Vùng an toàn 72dp giữa (mỗi cạnh 18dp), nội dung ở khoảng 22-86.
  Hình ví gồm: thân chữ nhật bo nhẹ, nắp trên, dây kéo khe nhỏ, miếng da tròn,
  chữ "₫" đơn giản hoá thành đường cong — tổng thể phẳng, dễ nhận diện.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Thân ví: hình chữ nhật bo góc 8dp, chiếm phần lớn vùng 30-82 -->
    <path
        android:fillColor="#F2EAD3"
        android:pathData="M30,42 L78,42 A4,4 0 0 1 82,46 L82,80 A4,4 0 0 1 78,84 L30,84 A4,4 0 0 1 26,80 L26,46 A4,4 0 0 1 30,42 Z" />

    <!-- Nắp ví (phần trên cao hơn một chút, cho cảm giác gập) -->
    <path
        android:fillColor="#E2D7B5"
        android:pathData="M34,38 L74,38 A2,2 0 0 1 76,40 L76,44 L32,44 L32,40 A2,2 0 0 1 34,38 Z" />

    <!-- Đường gân ngang — chỉ dấu may, mảnh -->
    <path
        android:fillColor="#C9BC8E"
        android:pathData="M28,52 L80,52 L80,53 L28,53 Z" />

    <!-- Nhãn tròn nhỏ (khoen kim) màu đậm hơn, hơi lệch trái -->
    <path
        android:fillColor="#C9A24A"
        android:pathData="M40,64 m-6,0 a6,6 0 1,0 12,0 a6,6 0 1,0 -12,0" />

    <!-- Chữ "đ" đơn giản hoá: vòng tròn + dấu sắc trên — đặt trong nhãn tròn -->
    <!-- Vòng tròn -->
    <path
        android:fillColor="#1F2A4A"
        android:pathData="M39,64 m-3,0 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0" />
    <!-- Dấu sắc (đường xiên nhỏ phía trên phải) -->
    <path
        android:fillColor="#1F2A4A"
        android:pathData="M42.5,58 L46,55 L47,56 L43.5,59 Z" />

    <!-- Tờ tiền nhô ra phía phải, hơi nghiêng — chỉ một đường thẳng bo -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M62,60 L82,60 A2,2 0 0 1 84,62 L84,72 A2,2 0 0 1 82,74 L62,74 Z" />
    <!-- Gờ tờ tiền -->
    <path
        android:fillColor="#E2D7B5"
        android:pathData="M62,60 L82,60 L82,62 L62,62 Z" />
    <!-- Số trên tờ tiền, dấu "-" đơn giản = chi tiêu -->
    <path
        android:fillColor="#1F2A4A"
        android:pathData="M70,66 L78,66 L78,68 L70,68 Z" />
</vector>
